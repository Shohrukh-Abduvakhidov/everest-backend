{
  "name": "everest-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EVEREST learning platform backend",
  "main": "src/server.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate:up": "node src/configs/migrate.js up",
    "migrate:down": "node src/configs/migrate.js down",
    "migrate:create": "node-pg-migrate create -m src/migrations -j js",
    "bootstrap:owner": "node scripts/bootstrap-owner.js",
    "storage:configure": "node scripts/configure-storage-bucket.js",
    "video:faststart": "node scripts/remux-faststart.js",
    "test:sources": "node scripts/verify-migration-sources.js",
    "test:integrity": "node scripts/test-schema-integrity.js",
    "test:server": "node scripts/test-server.js",
    "test:migrations": "node scripts/test-migration-cycle.js",
    "test:auth": "node --test --test-concurrency=1 tests/all.test.js",
    "test:telegram": "npm run test:auth",
    "test": "npm run test:sources && npm run test:integrity && npm run test:auth && npm run test:server"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jose": "^6.2.13",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "node-pg-migrate": "^8.0.3"
  }
}
