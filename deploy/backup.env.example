# Copy to /etc/everest/backup.env (chmod 600). Read by deploy/scripts/backup-db.sh and restore-check.sh.

# Where dumps are written on the host (directory is created with mode 700).
BACKUP_DIR=/var/backups/everest
# Compose project directory (contains docker-compose.prod.yml and .env).
EVEREST_DEPLOY_DIR=/opt/everest/backend/deploy
# Database to dump; defaults to DB_NAME from the deploy .env.
BACKUP_DB_NAME=
# age public key (age1...). Off-site copies are encrypted with it; the private key stays off the server.
AGE_RECIPIENT=
# rclone remote and path for off-site copies, e.g. b2:everest-backups. Empty = local only.
# Credentials live in the rclone config (chmod 600), never here.
BACKUP_RCLONE_REMOTE=
# Optional ping URL (healthchecks.io); "/fail" is appended on failure.
BACKUP_HEALTHCHECK_URL=
# Telegram alerts (separate admin bot, not the product bot).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# restore-check.sh: minimum expected row counts.
RESTORE_MIN_QUESTIONS=1
RESTORE_MIN_USERS=1
