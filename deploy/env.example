# Copy to deploy/.env on the server (chmod 600, owned by the deploy user). Never commit the real file.
# Generate secrets with: openssl rand -base64 48. Never reuse values from a developer machine.
# Lines marked [host] change when moving to the final domain (docs/deploy.md).

NODE_ENV=production
PORT=4100

# Database (container "db"). DB_USER is the application role.
DB_HOST=db
DB_PORT=5432
DB_NAME=everest_db
DB_USER=everest_app
DB_PASSWORD=
DB_POOL_MAX=15
# Superuser, only used when the db volume is initialised for the first time and for maintenance.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=

# [host] Origins allowed for cookie mutations (CSRF Origin check) and CORS.
CORS_ORIGINS=https://app.example.test
SWAGGER_ENABLED=false
# Host nginx -> docker-proxy -> container. Needs TRUST_PROXY support in the backend.
TRUST_PROXY=loopback,172.16.0.0/12

JWT_ACCESS_SECRET=
OTP_HMAC_SECRET=

# Object storage. S3_ENDPOINT is set to http://s3:8333 by compose.
# [host] Host signed into browser URLs.
S3_PUBLIC_ENDPOINT=https://files.example.test
S3_REGION=us-east-1
S3_BUCKET=everest-media
# Must match deploy/seaweedfs/s3.json.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# [host] Written into the bucket CORS rule by storage:configure.
STORAGE_CORS_ORIGINS=https://app.example.test
# Uploads. Part size 32 MiB (raised automatically to stay within 10,000 parts); part URLs
# live STORAGE_PRESIGN_TTL_SECONDS; an unfinished upload expires after STORAGE_UPLOAD_TTL_HOURS
# (must stay below the 3-day abort rule of storage:configure).
STORAGE_PART_SIZE_BYTES=33554432
STORAGE_PRESIGN_TTL_SECONDS=3600
STORAGE_UPLOAD_TTL_HOURS=48
# Lesson videos: one file at most 4 GiB, the whole library at most 15 GiB, 3 open uploads per user.
VIDEO_MAX_BYTES=4294967296
VIDEO_TOTAL_QUOTA_BYTES=16106127360
VIDEO_MAX_ACTIVE_UPLOADS=3
VIDEO_PLAYBACK_URL_TTL_SECONDS=7200
# How often worker:attempts also expires abandoned uploads.
UPLOAD_SWEEP_INTERVAL_MS=600000

# Frontend values read by compose (not by the backend).
# [host] Runtime: hosts served as the student app without /platform.
STUDENT_HOSTS=app.example.test
# [host] Build time: rebuild the frontend after changing.
APP_URL_STUDENT=https://app.example.test
# [host] Build time: landing URL used in links; set to the app URL while there is no landing host.
APP_URL_MARKETING=https://app.example.test

# Telegram login (optional; empty keeps it disabled). [host] TELEGRAM_REDIRECT_URI.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_REDIRECT_URI=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
