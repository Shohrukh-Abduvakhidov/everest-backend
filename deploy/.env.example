# Copy to .env on the server and fill in the secrets there. Never commit the real file.
# Generate secrets with: openssl rand -hex 32

NODE_ENV=production
PORT=4100

DB_HOST=db
DB_PORT=5432
DB_NAME=everest_db
DB_USER=everest
DB_PASSWORD=

CORS_ORIGINS=https://app.51-83-197-15.sslip.io
SWAGGER_ENABLED=true

JWT_ACCESS_SECRET=
OTP_HMAC_SECRET=

# Read by docker compose for the frontend build and runtime (not used by the backend).
STUDENT_HOSTS=app.51-83-197-15.sslip.io
APP_URL_STUDENT=https://app.51-83-197-15.sslip.io

# Optional and not needed for this stage: S3_ENDPOINT, S3_PUBLIC_ENDPOINT, S3_BUCKET,
# S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, SMS_API_KEY, TELEGRAM_*.
